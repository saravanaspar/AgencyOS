NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Internal service-to-service URL. Production Compose sets this to http://app:3000 for the worker.
INTERNAL_APP_URL=

# Local Podman PostgreSQL defaults. Use a long unique password and copy the
# same value into the two connection strings below.
AGENCYOS_POSTGRES_USER=agencyos
AGENCYOS_POSTGRES_PASSWORD=
AGENCYOS_POSTGRES_DB=agencyos
AGENCYOS_POSTGRES_PORT=5432
# Stable Podman volume name. Changing it points PostgreSQL at a different data directory.
AGENCYOS_POSTGRES_VOLUME=agencyos_postgres_data
DATABASE_URL=postgresql://agencyos:REPLACE_ME@127.0.0.1:5432/agencyos
# Runtime PostgreSQL pool size per application process.
DATABASE_POOL_MAX=10
# Direct/non-pooled PostgreSQL URL used only by migrations, tests, dump/restore, and provider moves.
DATABASE_ADMIN_URL=postgresql://agencyos:REPLACE_ME@127.0.0.1:5432/agencyos

# One server-only secret shared by the AgencyOS web and worker processes.
# Generate with: openssl rand -hex 32
INTERNAL_WORKER_SECRET=

# Independent out-of-band audit-pipeline failure alerts. Both may be omitted locally,
# but production requires an HTTPS URL and a distinct bearer secret of at least 32 characters.
AUDIT_PIPELINE_ALERT_WEBHOOK_URL=
AUDIT_PIPELINE_ALERT_WEBHOOK_SECRET=

# Required for AgencyOS-owned TOTP MFA secrets. Generate once and keep stable.
# Generate with: openssl rand -base64 32
AUTH_ENCRYPTION_KEY=
# Development only: expose email verification/reset tokens in action messages when email is not configured.
AUTH_DEV_SHOW_TOKENS=0

# Required before saving client-managed CRM or advertising credentials.
# Generate once with: openssl rand -base64 32
CRM_CONNECTOR_ENCRYPTION_KEY=

# Dependency readiness policy. Production defaults all three to required; local development defaults optional.
REDIS_REQUIRED=
MINIO_REQUIRED=
PRIVATE_FILE_SCANNER_REQUIRED=

# Optional locally; production is fail-closed when REDIS_REQUIRED is enabled.
# Local Podman service: redis://127.0.0.1:6379/0
# Production: authenticated TLS rediss:// URL.
AGENCYOS_REDIS_PORT=6379
AGENCYOS_REDIS_VOLUME=agencyos_redis_data
REDIS_URL=redis://127.0.0.1:6379/0

# Private MinIO object storage.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_REGION=us-east-1
AGENCYOS_MINIO_VOLUME=agencyos_minio_data

# Persistent ClamAV signature cache. Uploaded files are stored in MinIO, not here.
AGENCYOS_CLAMAV_VOLUME=agencyos_clamav_signatures

# Optional Vaultwarden web-vault base URL. AgencyOS stores item UUIDs only.
VAULTWARDEN_URL=

# Optional malware scanner. Start the bundled Podman ClamAV container with npm run scanner:start.
# Local ClamAV: clamav://127.0.0.1:3310
# The bearer token is only for a custom HTTPS scanner adapter; leave it blank for ClamAV.
PRIVATE_FILE_SCANNER_URL=
PRIVATE_FILE_SCANNER_BEARER_TOKEN=

# Optional direct Resend email delivery. Verify the sender domain in Resend first.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=AgencyOS <notifications@example.com>

# Optional payloadless Web Push. Generate VAPID keys with: npm run notifications:vapid
# Generate the encryption key with: openssl rand -base64 32
NOTIFICATION_DELIVERY_ENCRYPTION_KEY=
NOTIFICATION_VAPID_PUBLIC_KEY=
NOTIFICATION_VAPID_PRIVATE_KEY=
NOTIFICATION_VAPID_SUBJECT=mailto:notifications@example.com

# Shared HTML-to-PDF rendering.
HTML_PDF_CHROMIUM_PATH=
HTML_PDF_RENDER_TIMEOUT_MS=30000
# Legacy finance-only fallbacks during deployment migration.
FINANCE_PDF_CHROMIUM_PATH=
FINANCE_PDF_RENDER_TIMEOUT_MS=30000

# Authenticated internal-worker requests per minute.
SECURITY_WORKER_RATE_LIMIT_PER_MINUTE=120
# Production defaults to fail-closed. Use allow only for local development without Redis.
SECURITY_RATE_LIMIT_REDIS_FAILURE_MODE=

# Worker scheduler concurrency. Jobs still use distributed leases server-side.
WORKER_MAX_CONCURRENCY=3

# Optional CRM OAuth applications. Configure only the providers you use.
HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=
SALESFORCE_OAUTH_CLIENT_ID=
SALESFORCE_OAUTH_CLIENT_SECRET=
SALESFORCE_OAUTH_LOGIN_URL=https://login.salesforce.com
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
PIPEDRIVE_OAUTH_CLIENT_ID=
PIPEDRIVE_OAUTH_CLIENT_SECRET=

# AI providers. Configure at least one after organization AI governance is explicitly enabled.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-pro-preview
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro

# Disposable browser-audit environment only.
# AGENCYOS_E2E_BASE_URL=http://127.0.0.1:3000
# AGENCYOS_E2E_OWNER_EMAIL=owner@example.test
# AGENCYOS_E2E_OWNER_PASSWORD=replace-me
# AGENCYOS_E2E_OWNER_MFA_SECRET=BASE32SECRET
# AGENCYOS_E2E_ACCOUNTS_JSON=[{"name":"owner","email":"owner@example.test","password":"replace-me","mfaSecret":"BASE32SECRET","routes":["*"]}]
# AGENCYOS_E2E_CONFIRM_ISOLATED=1
# AGENCYOS_E2E_CLICK_DESTRUCTIVE=1

REPORT_DELIVERY_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Coolify production stack (placeholders only; store actual values in Coolify)
# -----------------------------------------------------------------------------
# Set once. Changing this after first deploy points services at new empty volumes.
AGENCYOS_VOLUME_PREFIX=agencyos-production
AGENCYOS_IMAGE=ghcr.io/OWNER/REPOSITORY@sha256:REPLACE_WITH_64_HEX_CHARACTERS
AGENCYOS_OPERATIONS_IMAGE=ghcr.io/OWNER/REPOSITORY-operations@sha256:REPLACE_WITH_64_HEX_CHARACTERS
AGENCYOS_RELEASE_ID=initial-install
AGENCYOS_TRUST_PRIVATE_SERVICE_NETWORK=0

# Use URL-safe generated values because these passwords are also embedded in private URLs.
# openssl rand -hex 32 is suitable for each password/secret below.
REDIS_PASSWORD=
MINIO_ROOT_USER=agencyos-root
MINIO_ROOT_PASSWORD=
VAULTWARDEN_DATABASE_USER=vaultwarden
VAULTWARDEN_DATABASE_NAME=vaultwarden
VAULTWARDEN_DATABASE_PASSWORD=
VAULTWARDEN_DATABASE_URL=postgresql://vaultwarden:REPLACE_ME@postgres:5432/vaultwarden
DATABASE_CONTROL_URL=postgresql://agencyos:REPLACE_ME@postgres:5432/postgres
VAULTWARDEN_SIGNUPS_ALLOWED=false
VAULTWARDEN_INVITATIONS_ALLOWED=false
# Optional Argon2 PHC string; leave empty to disable Vaultwarden admin UI.
VAULTWARDEN_ADMIN_TOKEN=

# Backblaze B2 S3 and restic. Enable Object Lock before the first upload.
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=
B2_PREFIX=agencyos/restic
# Writer: list/read/write/read-retention, no delete. Maintenance: separate read-only key.
B2_WRITER_KEY_ID=
B2_WRITER_APPLICATION_KEY=
B2_MAINTENANCE_KEY_ID=
B2_MAINTENANCE_APPLICATION_KEY=
# Read-only key used only in the isolated .env.recovery file during drills.
B2_RESTORE_KEY_ID=
B2_RESTORE_APPLICATION_KEY=
RESTIC_PASSWORD=
BACKUP_HOST=agencyos-production
BACKUP_HOUR_UTC=2
BACKUP_MAINTENANCE_HOUR_UTC=5
BACKUP_JITTER_MINUTES=20
BACKUP_MAX_AGE_HOURS=30
BACKUP_COMMAND_TIMEOUT_MS=3600000
BACKUP_KEEP_DAILY=35
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
BACKUP_KEEP_YEARLY=3
# Automatic remote pruning is unsupported; keep 0. See docs/BACKUP_RECOVERY.md.
BACKUP_PRUNE_ENABLED=0
BACKUP_SUCCESS_HEARTBEAT_URL=
BACKUP_FAILURE_WEBHOOK_URL=
BACKUP_FAILURE_WEBHOOK_SECRET=

# GitHub release environment (GitHub variables/secrets, not Coolify runtime values).
COOLIFY_BASE_URL=https://coolify.example.com
COOLIFY_APPLICATION_UUID=
COOLIFY_API_TOKEN=
PRODUCTION_APP_URL=https://agency.example.com

# Isolated restore drill only. Put these in an ignored .env.recovery, never production.
AGENCYOS_RESTORE_DRILL=0
AGENCYOS_RESTORE_SNAPSHOT=
AGENCYOS_RECOVERY_ID=
AGENCYOS_RECOVERY_ROOT=/recovery
RECOVERY_TARGET_CONFIRM=
RECOVERY_DATABASE_ADMIN_URL=
RECOVERY_VAULTWARDEN_DATABASE_URL=
RECOVERY_MINIO_ENDPOINT=
RECOVERY_MINIO_ACCESS_KEY=
RECOVERY_MINIO_SECRET_KEY=
RECOVERY_VAULTWARDEN_DATA_DIR=
