# AgencyOS runtime
#
# Keep this file small: infrastructure connections and server-held root secrets only.
# Optional AI, browser-push, and Vaultwarden values are configured after sign-in at
# Settings -> Integrations. CRM credentials are configured per connection.

# Public origin used for links and OAuth callbacks.
APP_URL=http://localhost:3000

# Runtime and direct/admin PostgreSQL connections.
DATABASE_URL=postgresql://agencyos:REPLACE_ME@127.0.0.1:5432/agencyos
DATABASE_ADMIN_URL=postgresql://agencyos:REPLACE_ME@127.0.0.1:5432/agencyos

# Stable server-only secrets. Generate each independently and keep them unchanged.
# openssl rand -hex 32
INTERNAL_WORKER_SECRET=
# openssl rand -base64 32
AUTH_ENCRYPTION_KEY=
# Encrypts CRM credentials and application-managed integration settings.
CRM_CONNECTOR_ENCRYPTION_KEY=

# Runtime dependency connections. Keep the variable names unchanged and replace only
# the URLs/credentials when moving from bundled services to managed providers.
# PostgreSQL: self-hosted or Neon/another PostgreSQL provider.
# Redis: local/self-hosted Redis or an Upstash native rediss:// endpoint.
REDIS_URL=redis://127.0.0.1:6379/0
# Object storage: self-hosted S3, Backblaze B2, Cloudflare R2, or another S3-compatible service.
# B2 example: https://s3.REGION.backblazeb2.com with its real region.
# R2 example: https://ACCOUNT_ID.r2.cloudflarestorage.com with region=auto.
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=agencyos-runtime
# Optional infrastructure. Production defaults PRIVATE_FILE_SCANNER_REQUIRED=1; set it to 0 only
# when deliberately accepting a deployment without malware scanning.
PRIVATE_FILE_SCANNER_URL=clamav://127.0.0.1:3310
# PRIVATE_FILE_SCANNER_REQUIRED=0

# Required only when starting the bundled PostgreSQL container.
# AGENCYOS_POSTGRES_PASSWORD=

# Resend remains the platform email provider and bootstrap fallback.
RESEND_API_KEY=
NOTIFICATION_EMAIL_FROM=

# Optional feature encryption roots. Uncomment only when enabled.
# NOTIFICATION_DELIVERY_ENCRYPTION_KEY=
# REPORT_DELIVERY_ENCRYPTION_KEY=

# Production-only out-of-band audit alerts. Configure these in the deployment platform,
# not in .env.local. Both are required by production startup validation.
# AUDIT_PIPELINE_ALERT_WEBHOOK_URL=https://alerts.example.com/agencyos
# AUDIT_PIPELINE_ALERT_WEBHOOK_SECRET=

# Browser/E2E credentials belong in ignored .env.e2e.local, not .env.local.
# AGENCYOS_E2E_BASE_URL=http://127.0.0.1:3000
# AGENCYOS_E2E_OWNER_EMAIL=owner@example.test
# AGENCYOS_E2E_OWNER_PASSWORD=replace-me
# AGENCYOS_E2E_CONFIRM_ISOLATED=1
