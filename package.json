{
  "name": "agencyos",
  "version": "0.1.0",
  "private": true,
  "description": "AgencyOS modular agency operations platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --project tsconfig.verify.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run security:framework && npm run security:supply-chain && npm run security:tenant-scope && npm run security:mutation-boundaries && npm run security:sensitive-content && npm run quality:complexity",
    "verify": "npm run check && npm test && npm run db:check && npm run build",
    "db:reset": "node -e \"console.error('Blocked: AgencyOS uses forward-only provider-neutral migrations. Database reset is disabled.'); process.exit(1)\"",
    "db:pull": "node -e \"console.error('Blocked: AgencyOS is migration-file-first. Use forward migrations instead of schema pulls.'); process.exit(1)\"",
    "db:test": "node --env-file-if-exists=.env.local scripts/database/test-portable.mjs",
    "db:check": "node scripts/database/validate-migrations.mjs",
    "test": "vitest run",
    "archive:source": "node scripts/archive-source.mjs agencyos-source.zip",
    "coolify:config": "docker compose -f compose.coolify.yaml config --quiet",
    "release:production": "node scripts/release/production-release.mjs",
    "backup:now": "node --env-file-if-exists=.env.local scripts/backup/run-backup.mjs --reason=manual",
    "backup:status": "node --env-file-if-exists=.env.local scripts/backup/health.mjs",
    "backup:check": "node --env-file-if-exists=.env.local scripts/backup/run-maintenance.mjs --weekly",
    "backup:maintenance": "node --env-file-if-exists=.env.local scripts/backup/run-maintenance.mjs --monthly",
    "backup:restore:prepare": "node --env-file-if-exists=.env.recovery scripts/backup/restore-prepare.mjs",
    "backup:restore:components": "node --env-file-if-exists=.env.recovery scripts/backup/restore-components.mjs",
    "notifications:vapid": "node scripts/generate-vapid-keys.mjs",
    "redis:check": "node --env-file-if-exists=.env.local scripts/check-redis.mjs",
    "redis:start": "podman-compose --project-name agencyos-dependencies --env-file .env.local -f compose.redis.yaml up -d",
    "redis:stop": "podman-compose --project-name agencyos-dependencies -f compose.redis.yaml stop redis",
    "redis:logs": "podman-compose --project-name agencyos-dependencies -f compose.redis.yaml logs -f redis",
    "storage:setup": "node --env-file-if-exists=.env.local scripts/storage/setup-minio.mjs",
    "storage:check": "node --env-file-if-exists=.env.local scripts/storage/check-minio.mjs",
    "storage:start": "podman-compose --project-name agencyos-dependencies --env-file .env.local -f compose.minio.yaml up -d",
    "storage:stop": "podman-compose --project-name agencyos-dependencies --env-file .env.local -f compose.minio.yaml stop minio",
    "storage:logs": "podman-compose --project-name agencyos-dependencies --env-file .env.local -f compose.minio.yaml logs -f minio",
    "doctor": "node scripts/run-react-doctor.mjs",
    "security:deployment:verify": "node --env-file-if-exists=.env.local scripts/operations/verify-deployment.mjs",
    "test:ui:source": "node scripts/testing/ui-control-inventory.mjs --check",
    "test:e2e": "node --env-file-if-exists=.env.local scripts/testing/run-playwright.mjs",
    "verify:release": "npm run verify && npm run db:status && npm run db:doctor && npm run db:test && npm run test:pdf-runtime && npm run test:e2e",
    "test:pdf-runtime": "vitest run --fileParallelism=false tests/unit/finance-document-delivery.test.ts tests/unit/hr-salary.test.ts tests/unit/hr-documents.test.ts",
    "worker": "node --env-file-if-exists=.env.local scripts/workers/run.mjs",
    "scanner:start": "podman-compose --project-name agencyos-dependencies -f compose.scanner.yaml up -d",
    "scanner:stop": "podman-compose --project-name agencyos-dependencies -f compose.scanner.yaml stop clamav",
    "scanner:logs": "podman-compose --project-name agencyos-dependencies -f compose.scanner.yaml logs -f clamav",
    "scanner:check": "node --env-file-if-exists=.env.local scripts/scanner/check-clamav.mjs",
    "db:start": "podman-compose --project-name agencyos-dependencies --env-file .env.local -f compose.database.yaml up -d --build",
    "db:stop": "podman-compose --project-name agencyos-dependencies --env-file .env.local -f compose.database.yaml stop postgres",
    "db:logs": "podman-compose --project-name agencyos-dependencies --env-file .env.local -f compose.database.yaml logs -f postgres",
    "dependencies:start": "podman-compose --project-name agencyos-dependencies --env-file .env.local -f compose.database.yaml -f compose.redis.yaml -f compose.minio.yaml -f compose.scanner.yaml up -d --build",
    "dependencies:stop": "podman-compose --project-name agencyos-dependencies --env-file .env.local -f compose.database.yaml -f compose.redis.yaml -f compose.minio.yaml -f compose.scanner.yaml down",
    "dependencies:status": "podman-compose --project-name agencyos-dependencies --env-file .env.local -f compose.database.yaml -f compose.redis.yaml -f compose.minio.yaml -f compose.scanner.yaml ps",
    "container:build": "podman build --pull=always --format=oci -f Containerfile -t localhost/agencyos:local .",
    "production:start": "podman-compose --project-name agencyos-production --env-file .env.production -f compose.production.yaml up -d",
    "production:stop": "podman-compose --project-name agencyos-production --env-file .env.production -f compose.production.yaml down",
    "production:status": "podman-compose --project-name agencyos-production --env-file .env.production -f compose.production.yaml ps",
    "production:logs": "podman-compose --project-name agencyos-production --env-file .env.production -f compose.production.yaml logs -f",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/database/migrate.mjs",
    "db:status": "node --env-file-if-exists=.env.local scripts/database/status.mjs",
    "db:doctor": "node --env-file-if-exists=.env.local scripts/database/doctor.mjs",
    "db:copy": "node --env-file-if-exists=.env.local scripts/database/copy-database.mjs",
    "cutover:remove-legacy-provider": "node scripts/cutover/remove-legacy-provider-artifacts.mjs",
    "security:framework": "node scripts/security/verify-framework-baseline.mjs",
    "security:supply-chain": "node scripts/security/verify-supply-chain.mjs",
    "security:tenant-scope": "node scripts/security/audit-tenant-scope.mjs",
    "security:mutation-boundaries": "node scripts/security/check-mutation-boundaries.mjs",
    "quality:complexity": "node scripts/quality/check-complexity-budget.mjs",
    "ai:policy": "node --env-file-if-exists=.env.local scripts/operations/configure-ai-policy.mjs",
    "test:e2e:seed": "node --env-file-if-exists=.env.local scripts/testing/seed-e2e.mjs",
    "security:sensitive-content": "node scripts/security/check-sensitive-content-boundaries.mjs",
    "security:restore-drill:verify": "node --env-file-if-exists=.env.local scripts/operations/verify-restore-drill.mjs"
  },
  "engines": {
    "node": ">=22.23.2 <23"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@sparticuz/chromium": "^147.0.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "minio": "^8.0.7",
    "next": "16.2.11",
    "postgres": "^3.4.9",
    "puppeteer-core": "^25.9.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "read-excel-file": "^9.2.0",
    "redis": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.2.10",
    "prettier": "^3.9.5",
    "react-doctor": "^0.7.8",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "ip-address": "^10.7.0",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23",
    "sharp": "0.35.3",
    "undici": "^7.29.0"
  }
}
