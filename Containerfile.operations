FROM docker.io/restic/restic:0.18.1@sha256:39d9072fb5651c80d75c7a811612eb60b4c06b32ffe87c2e9f3c7222e1797e76 AS restic
FROM docker.io/minio/mc:RELEASE.2025-08-13T08-35-41Z@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727 AS object-storage-client
FROM docker.io/library/node:22.23.2-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436 AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

FROM docker.io/library/postgres:17.10-bookworm@sha256:4f736ae292687621d4dbe0d499ffd024a36bd2ee7d8ca6f2ccd4c800f047b394 AS operations
ARG AGENCYOS_REVISION=unknown
ARG AGENCYOS_SOURCE=https://github.com/REPLACE_ME/AgencyOS
LABEL org.opencontainers.image.title="AgencyOS operations" \
      org.opencontainers.image.revision="$AGENCYOS_REVISION" \
      org.opencontainers.image.source="$AGENCYOS_SOURCE"
WORKDIR /app
ENV NODE_ENV=production \
    AGENCYOS_BACKUP_STATE_DIR=/state \
    AGENCYOS_BACKUP_STAGE_DIR=/stage \
    AGENCYOS_RECOVERY_ROOT=/recovery \
    RESTIC_CACHE_DIR=/cache
RUN apt-get update \
  && apt-get install --yes --no-install-recommends ca-certificates util-linux \
  && rm -rf /var/lib/apt/lists/* \
  && mkdir -p /state /stage /cache /recovery /release-status
COPY --from=dependencies /usr/local/bin/node /usr/local/bin/node
COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=restic /usr/bin/restic /usr/local/bin/restic
COPY --from=object-storage-client /usr/bin/mc /usr/local/bin/mc
COPY package.json ./
COPY database/migrations ./database/migrations
COPY database/tests ./database/tests
COPY src ./src
COPY scripts/database ./scripts/database
COPY scripts/storage ./scripts/storage
COPY scripts/operations ./scripts/operations
COPY scripts/backup ./scripts/backup
RUN node --version \
  && pg_dump --version \
  && restic version \
  && mc --version
ENTRYPOINT []
CMD ["node", "scripts/backup/health.mjs"]
